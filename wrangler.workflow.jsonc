{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "argus-workflow",
	"account_id": "bfcb6ac5b3ceaf42a09607f6f7925823",
	"compatibility_date": "2026-05-19",
	"compatibility_flags": [
		"nodejs_als"
	],
	"main": "src/worker.ts",
	"ai": { "binding": "AI" },
	"workflows": [
		{
			"name": "argus-research",
			"binding": "ARGUS_RESEARCH",
			"class_name": "ArgusResearchWorkflow"
		}
	],
	"workers_dev": true,
	"preview_urls": true
}
